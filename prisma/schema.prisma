generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Role User
enum Role {
  ADMIN_ADMINISTRASI
  ADMIN_TRANSAKSI
  GURU
  SISWA
}

// Jenis transaksi tabungan
enum JenisMutasi {
  DEBET
  KREDIT
}

// Status Pembayaran SPP
enum StatusBayar {
  BELUM_LUNAS
  LUNAS
  BATAL
}

// Status Setoran Uang Fisik (Kas Riil vs Kas Pending)
enum StatusSetoran {
  SUDAH
  BELUM
}

// Predikat Penilaian Murojaah
enum PredikatNilai {
  SB // Sangat Baik
  B  // Baik
  C  // Cukup
  K  // Kurang
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  nama      String
  password  String
  role      Role     @default(GURU)
  siswaId   String?  @unique
  siswa     Siswa?   @relation(fields: [siswaId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  kelasAmpu Kelas[]  @relation("WaliKelasRelasi")
  // Log Petugas yang menginput transaksi
  pembayaranSpp  TransaksiSpp[]
  mutasiTabungan MutasiTabungan[]
  penilaianMurojaah PenilaianMurojaah[]

  kegiatanDokumentasi KegiatanDokumentasi[]

  @@map("users")
}

model Kelas {
  id          String   @id @default(uuid())
  namaKelas   String   @map("nama_kelas") // misal: "Kelas A - Bintang"
  waliKelas   String?  @map("wali_kelas")
  tahunAjaran String   @map("tahun_ajaran") // misal: "2025/2026"
  // Relasi ke User (Guru)
  guruId      String?  @map("guru_id")
  guru        User?    @relation("WaliKelasRelasi", fields: [guruId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  siswa Siswa[]

  @@map("kelas")
}

model Siswa {
  id           String  @id @default(uuid())
  nis          String? @unique
  nisn          String?   @unique
  namaLengkap  String  @map("nama_lengkap")
  jenisKelamin String?  @map("jenis_kelamin")
  namaOrangTua String  @map("nama_orang_tua")
  alamat        String?
  tinggiBadan   Float?
  beratBadan    Float?
  lingkarKepala Float?
  semester      String?
  tahunAjaran   String?
  kelasId      String? @map("kelas_id")
  kelas        Kelas?  @relation(fields: [kelasId], references: [id], onDelete: SetNull)
  user         User?

  saldoTabungan Decimal @default(0) @map("saldo_tabungan") @db.Decimal(12, 2)

  transaksiSpp   TransaksiSpp[]
  mutasiTabungan MutasiTabungan[]
  penilaianMurojaah PenilaianMurojaah[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("siswa")
}

model TransaksiSpp {
  id            String  @id @default(uuid())
  nomorKwitansi String? @unique @map("nomor_kwitansi")
  siswaId       String  @map("siswa_id")

  bulan Int? // Opsional jika bayar berdasarkan tanggal
  tahun Int? // e.g. 2026
  tahunAjaran   String? @map("tahun_ajaran")

  // Field Rincian Pembayaran
  nominalSpp Decimal @default(0) @map("nominal_spp") @db.Decimal(12, 2)
  nominalLes Decimal @default(0) @map("nominal_les") @db.Decimal(12, 2)
  totalBayar Decimal @map("total_bayar") @db.Decimal(12, 2)

  status        StatusBayar   @default(LUNAS)
  statusSetoran StatusSetoran @default(BELUM) @map("status_setoran")
  tanggalBayar  DateTime      @default(now()) @map("tanggal_bayar")

  petugasId String? @map("petugas_id")
  catatan   String? @db.Text

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  siswa   Siswa @relation(fields: [siswaId], references: [id], onDelete: Cascade)
  petugas User? @relation(fields: [petugasId], references: [id], onDelete: SetNull)
  
  @@unique([siswaId, bulan, tahun], name: "unique_pembayaran_bulan_tahun")
  @@map("transaksi_spp")
}

model MutasiTabungan {
  id      String @id @default(uuid())
  siswaId String @map("siswa_id")
  siswa   Siswa  @relation(fields: [siswaId], references: [id], onDelete: Cascade)

  tanggal      DateTime    @default(now())
  jenisMutasi  JenisMutasi @map("jenis_mutasi") // DEBET | KREDIT
  nominal      Decimal     @db.Decimal(12, 2)
  saldoSebelum Decimal     @map("saldo_sebelum") @db.Decimal(12, 2)
  saldoSesudah Decimal     @map("saldo_sesudah") @db.Decimal(12, 2)

  keterangan String? @db.Text
  petugasId  String? @map("petugas_id")
  petugas    User?   @relation(fields: [petugasId], references: [id], onDelete: SetNull)

  deletedAt DateTime? @map("deleted_at") // Soft Delete
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("mutasi_tabungan")
}

// 1. Kategori Murojaah (e.g. Surat Pendek, Doa Harian, Hadits Pilihan)
model KategoriMurojaah {
  id        String   @id @default(uuid())
  nama      String   // Misal: "Surat Pendek"
  urutan    Int      @default(0) // Untuk mengurutkan tab kategori di UI
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  materi MateriMurojaah[]

  @@map("kategori_murojaah")
}

// 2. Item Materi Murojaah (e.g. Al-Fatihah, Doa Kedua Orang Tua)
model MateriMurojaah {
  id         String           @id @default(uuid())
  kategoriId String           @map("kategori_id")
  kategori   KategoriMurojaah @relation(fields: [kategoriId], references: [id], onDelete: Cascade)
  
  nama       String           // Misal: "Al-Kautsar"
  urutan     Int              @default(0)
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  penilaian PenilaianMurojaah[]

  @@map("materi_murojaah")
}

// 3. Nilai Per Murid per Materi (Transactional UPSERT)
model PenilaianMurojaah {
  id        String        @id @default(uuid())
  siswaId   String        @map("siswa_id")
  siswa     Siswa         @relation(fields: [siswaId], references: [id], onDelete: Cascade)
  
  materiId  String        @map("materi_id")
  materi    MateriMurojaah @relation(fields: [materiId], references: [id], onDelete: Cascade)
  
  predikat  PredikatNilai? // NULL / undefined berarti "-" (Belum dinilai)
  
  petugasId String?       @map("petugas_id")
  petugas   User?         @relation(fields: [petugasId], references: [id], onDelete: SetNull)

  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  // Compound Unique constraint: 1 Siswa hanya punya 1 record nilai per Materi
  @@unique([siswaId, materiId])
  @@map("penilaian_murojaah")
}

model KegiatanDokumentasi {
  id              String            @id @default(uuid())
  namaKegiatan    String            @map("nama_kegiatan")
  kategori        String            @map("kategori")
  tanggalKegiatan DateTime          @default(now()) @map("tanggal_kegiatan")
  deskripsi       String?           @db.Text
  gdriveFolderId  String?           @map("gdrive_folder_id")
  gdriveFolderUrl String?           @map("gdrive_folder_url")
  isPublic        Boolean            @default(false) // Ditampilkan di Landing Page atau tidak
  thumbnailFotoId String?
  
  petugasId       String?           @map("petugas_id")
  petugas         User?             @relation(fields: [petugasId], references: [id], onDelete: SetNull)

  foto            FotoDokumentasi[]
  deletedAt       DateTime?         @map("deleted_at")

  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  @@map("kegiatan_dokumentasi")
}

model FotoDokumentasi {
  id          String              @id @default(uuid())
  kegiatanId  String              @map("kegiatan_id")
  kegiatan    KegiatanDokumentasi @relation(fields: [kegiatanId], references: [id], onDelete: Cascade)
  
  namaFile    String              @map("nama_file")
  gdriveFileId String             @map("gdrive_file_id")
  viewUrl     String              @map("view_url") @db.Text
  downloadUrl String?             @map("download_url") @db.Text

  createdAt   DateTime            @default(now()) @map("created_at")

  @@map("foto_dokumentasi")
}

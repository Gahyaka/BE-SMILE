generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Role hanya Admin dan Guru
enum Role {
  ADMIN
  GURU
}

// Jenis transaksi tabungan
enum JenisTabungan {
  SETOR
  TARIK
}

// Status Pembayaran SPP (Manual)
enum StatusBayar {
  LUM_LUNAS
  LUNAS
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  nama      String
  password  String
  role      Role     @default(GURU)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relasi log petugas yang menginput transaksi
  pembayaranSpp TransaksiSpp[]
  mutasiTabungan TabunganSiswa[]

  @@map("users")
}

model Kelas {
  id          String   @id @default(uuid())
  namaKelas   String   @map("nama_kelas") // misal: "Kelas A - Bintang"
  waliKelas   String?  @map("wali_kelas")
  tahunAjaran String   @map("tahun_ajaran") // misal: "2025/2026"
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  siswa Siswa[]

  @@map("kelas")
}

model Siswa {
  id           String   @id @default(uuid())
  nis          String?  @unique
  namaLengkap  String   @map("nama_lengkap")
  namaOrangTua String   @map("nama_orang_tua")
  kelasId      String?  @map("kelas_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  kelas    Kelas?          @relation(fields: [kelasId], references: [id], onDelete: SetNull)
  spp      TransaksiSpp[]
  tabungan TabunganSiswa[]

  @@map("siswa")
}

model TransaksiSpp {
  id             String      @id @default(uuid())
  nomorKwitansi  String      @unique @map("nomor_kwitansi") // Misal: KW-SPP-202607-001
  siswaId        String      @map("siswa_id")
  bulan          Int         // 1 - 12
  tahun          Int         // e.g. 2026
  nominal        Decimal     @db.Decimal(12, 2)
  status         StatusBayar @default(LUM_LUNAS)
  tanggalBayar   DateTime?   @map("tanggal_bayar")
  petugasId      String?     @map("petugas_id") // Siapa admin/guru yang mencatat
  catatan        String?
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  siswa   Siswa @relation(fields: [siswaId], references: [id], onDelete: Cascade)
  petugas User? @relation(fields: [petugasId], references: [id], onDelete: SetNull)

  @@map("transaksi_spp")
}

model TabunganSiswa {
  id            String        @id @default(uuid())
  nomorKwitansi String?       @map("nomor_kwitansi") // Untuk pencetakan bukti setor/tarik
  siswaId       String        @map("siswa_id")
  jenis         JenisTabungan // SETOR atau TARIK
  nominal       Decimal       @db.Decimal(12, 2)
  saldoAkhir    Decimal       @map("saldo_akhir") @db.Decimal(12, 2) // Cache saldo setelah transaksi
  petugasId     String?       @map("petugas_id")
  keterangan    String?
  createdAt     DateTime      @default(now()) @map("created_at")

  siswa   Siswa @relation(fields: [siswaId], references: [id], onDelete: Cascade)
  petugas User? @relation(fields: [petugasId], references: [id], onDelete: SetNull)

  @@map("tabungan_siswa")
}